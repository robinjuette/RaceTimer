        </div>
        <div class="timing-timeline-range">
            <span>Betrachteter Zeitraum:</span>
            <strong>@TimelineStartUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") – @TimelineEndUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</strong>
        </div>
