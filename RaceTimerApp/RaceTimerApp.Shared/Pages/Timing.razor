    <div class="timing-assignment-layout">
        <div class="card mb-3 timing-open-timepoints">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Offene Zeitpunkte <span class="badge bg-danger">@UnassignedTimePoints.Count</span></h5>
            </div>
            <div class="card-body">
                @if (UnassignedTimePoints.Any())
                {
                    <div class="timing-open-timepoint-cards">
                        @foreach (var tp in UnassignedTimePoints.OrderBy(tp => tp.TimePointUTC))
                        {
                            <div class="timing-open-timepoint-card @(SelectedTimePoint?.Id == tp.Id ? "active" : "")"
                                 @onclick="() => SelectOpenTimePoint(tp)">
                                <div class="timing-open-timepoint-content">
                                    <strong>@tp.TimePointUTC.ToLocalTime().ToString("HH:mm:ss")</strong>
                                    <span>Erfasst vor @((DateTime.UtcNow - tp.TimePointUTC).FormatShort())</span>
                                </div>
                                <button class="btn btn-danger btn-sm" @onclick:stopPropagation="true" @onclick="() => DeleteTimePoint(tp.Id)">Löschen</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">Keine offenen Zeitpunkte</div>
                }
            </div>
        </div>

        <!-- Teilnehmer zur Zuordnung -->
        <div class="timing-right-column">
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Aktive Teilnehmer</h5>
            </div>
            <div class="card-body">
                @if (AvailableFTPs.Any())
                {
                    <div style="display:flex; flex-direction:row; flex-wrap:wrap">
                        @foreach (var raceGroup in AvailableFTPs.GroupBy(ftp => ftp.Race.Id))
                        {
                            @if (_multipleRaces)
                            {
                                <h6 class="w-100 mt-2">@raceGroup.First().Race.Name</h6>
                            }
                            @foreach (FutureRaceParticipantTimePoint ftp in raceGroup.OrderBy(ftp => ftp.RaceParticipant.ParticipantNr))
                            {
                                <div @onclick="() => SelectFTP(ftp)"
                                class="participant-item active"
                                style="cursor: pointer; margin:1%; background-color: @(SelectedFTP?.Race.Id == ftp.Race.Id && SelectedFTP?.RaceParticipant.ParticipantID == ftp.RaceParticipant.ParticipantID ? "#e7f3ff" : "#cccccc33")">
                                    <div style="display:flex; flex-direction:column;">
                                        <div style="display:flex; flex-direction:row;">
                                            <strong class="participant-number" style="align-self:center">#@ftp.RaceParticipant.ParticipantNr</strong>
                                            <div style="display:flex; flex-direction:column;">
                                                <span class="participant-name">@ftp.RaceParticipant.Participant.DisplayName</span>
                                                <span>@ftp.RaceTimePoint.DisplayName</span>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">Keine aktiven Teilnehmer</div>
                }
            </div>
        </div>

    </div>

    @if (SelectedTimePoint is not null && SelectedFTP is not null)
    {
        <div class="card timing-assignment-card">
            <div class="card-body">
                <h6 class="card-title">Zuordnung prüfen</h6>
                <div class="timing-assignment-summary">
                    <div><span class="text-muted">Zeitpunkt</span><strong>@SelectedTimePoint.TimePointUTC.ToLocalTime().ToString("HH:mm:ss")</strong></div>
                    <div><span class="text-muted">Teilnehmer</span><strong>#@SelectedFTP.Value.RaceParticipant.ParticipantNr @SelectedFTP.Value.RaceParticipant.Participant.DisplayName</strong></div>
                    <div><span class="text-muted">Fortschritt</span><strong>@SelectedFTP.Value.RaceTimePoint.DisplayName</strong></div>
                </div>
                <button class="btn btn-success btn-assign-timepoint" @onclick="AssignTimePoint">
                    <span class="oi oi-check"></span> Zeitpunkt zuordnen
                </button>
            </div>
        </div>
    }
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">Erfasste Zeitpunkte</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead><tr><th>Zeit</th><th>Rennen</th><th>Teilnehmer</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var tp in TimelineTimePoints.OrderByDescending(tp => tp.TimePointUTC))
                    {
                        <tr>
                            <td>@tp.TimePointUTC.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td>@(tp.Race?.Name ?? "Nicht zugeordnet")</td>
                            <td>@(tp.Participant?.DisplayName ?? "-")</td>
                            <td>@(tp.RaceID.HasValue ? "Zugeordnet" : "Offen")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .timing-page {
    min-width: 0;
    }

    .timing-assignment-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .8fr);
    gap: 1rem;
    align-items: start;
    }

    .timing-right-column {
    min-width: 0;
    }

    .timing-assignment-card {
    grid-column: 1 / -1;
    }

    .timing-open-timepoint-cards {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: .75rem;
    }

    .timing-open-timepoint-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .75rem 1rem;
    border: 1px solid #dee2e6;
    border-radius: .375rem;
    background: white;
    cursor: pointer;
    }

    .timing-open-timepoint-card:hover,
    .timing-open-timepoint-card.active {
    background: #e7f3ff;
    border-color: #0d6efd;
    }

    .timing-open-timepoint-content {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    }

    .btn-assign-timepoint {
    width: 100%;
    padding: 15px 20px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 6px;
    min-height: 50px;
    }

    .timing-timeline-scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 3rem 0 4rem;
    scrollbar-width: thin;
    }

    .timing-timeline {
    position: relative;
    height: 5rem;
    min-width: 1200px;
    }

    .timing-timeline-range {
    display: flex;
    justify-content: center;
    gap: .5rem;
    flex-wrap: wrap;
    padding: .75rem 1rem 0;
    color: #495057;
    font-size: .9rem;
    }

    .timing-assignment-summary {
    display: grid;
    gap: .5rem;
    margin-bottom: 1rem;
    }

    .timing-assignment-summary div {
    display: flex;
    flex-direction: column;
    }

    @@media (max-width: 768px) {
    .timing-assignment-layout {
    grid-template-columns: 1fr;
    }
    }

    .timing-timeline-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 2.4rem;
    height: 3px;
    background: #6c757d;
    }

    .timing-timeline-now {
    position: absolute;
    top: 0;
    height: 5rem;
    border-left: 2px dashed #dc3545;
    }

    .timing-timeline-now span {
    position: absolute;
    top: -1.5rem;
    transform: translateX(-50%);
    color: #dc3545;
    font-weight: 600;
    }

    .timing-timeline-event {
    position: absolute;
    top: 1.55rem;
    transform: translateX(-50%);
    z-index: 1;
    }

    .timing-timeline-event.unassigned {
    cursor: pointer;
    }

    .timing-timeline-marker {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: #198754;
    border: 3px solid white;
    box-shadow: 0 0 0 1px #198754;
    }

    .timing-timeline-event.unassigned .timing-timeline-marker {
    background: #ffc107;
    box-shadow: 0 0 0 1px #cc9a06;
    }

    .timing-timeline-label {
    position: absolute;
    top: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: .75rem;
    }
</style>

@code {
    private List<RaceParticipantTimePoint> UnassignedTimePoints = [];
    private List<RaceParticipantTimePoint> TimelineTimePoints = [];
    private RaceParticipantTimePoint? SelectedTimePoint;
    private FutureRaceParticipantTimePoint? SelectedFTP;
    private List<FutureRaceParticipantTimePoint> AvailableFTPs = [];
    private TimingServiceUpdateEndpoint? updateEndpoint;
    private bool _multipleRaces = false;
    private decimal _timelineZoom = 1m;
    private bool _timelineInitialized;

    private DateTime TimelineStartUtc => TimelineTimePoints.Any()
        ? TimelineTimePoints.Min(tp => tp.TimePointUTC).AddMinutes(-1)
        : DateTime.UtcNow.AddMinutes(-1);

    private DateTime TimelineEndUtc => TimelineTimePoints.Any()
        ? (TimelineTimePoints.Max(tp => tp.TimePointUTC) > DateTime.UtcNow
            ? TimelineTimePoints.Max(tp => tp.TimePointUTC)
            : DateTime.UtcNow).AddMinutes(1)
        : DateTime.UtcNow.AddMinutes(1);

    private double TimelineWidthPx => Math.Max(1200, (TimelineEndUtc - TimelineStartUtc).TotalMinutes * 60 * (double)_timelineZoom);

    protected override async Task OnInitializedAsync()
    {
        updateEndpoint = new(TimingPoint_Changed);
        TimingService.RegisterForCallback(updateEndpoint);
        await LoadData();
        _ = UIRefresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_timelineInitialized)
        {
            _timelineInitialized = true;
            await JS.InvokeVoidAsync("raceTimerTimeline.scrollToCurrent", "timing-timeline-scroll");
        }
    }


    private async Task UIRefresh()
    {
        while (true)
        {
            await Task.Delay(1000);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectOpenTimePoint(RaceParticipantTimePoint tp)
    {
        SelectTimePoint(tp);
        await JS.InvokeVoidAsync("raceTimerTimeline.scrollToElement", "timing-timeline-scroll", TimelineElementId(tp));
    }

    private void ZoomIn()
    {
        _timelineZoom = Math.Min(4m, _timelineZoom + 0.5m);
    }

    private void ZoomOut()
    {
        _timelineZoom = Math.Max(0.5m, _timelineZoom - 0.5m);
    }

    private double TimelinePosition(DateTime timePointUtc)
    {
        double totalTicks = (TimelineEndUtc - TimelineStartUtc).Ticks;
        return totalTicks <= 0 ? 0 : Math.Clamp((timePointUtc - TimelineStartUtc).Ticks / totalTicks * 100, 0, 100);
    }

    private double TimelinePositionPx(DateTime timePointUtc)
    {
        return TimelinePosition(timePointUtc) / 100 * TimelineWidthPx;
    }

    private string TimelineElementId(RaceParticipantTimePoint tp) => $"timing-event-{tp.Id:N}";

    private string TimelineLabel(RaceParticipantTimePoint tp) =>
        $"{tp.TimePointUTC.ToLocalTime():HH:mm:ss} - {tp.Race?.Name ?? "Nicht zugeordnet"}";


    private void TimingPoint_Changed(RaceParticipantTimePoint? changed)
    {
        _ = LoadData();
    }

    private async Task LoadData()
    {
        List<Race> runningRaces = (await RaceService.GetRunningRacesAsync()).ToList();

        _multipleRaces = runningRaces.Count > 1;

        AvailableFTPs.Clear();
        TimelineTimePoints = [];
        foreach (Race race in runningRaces)
        {
            List<RankingEntry> rankings = await RankingService.GetRankingsAsync(race.Id);
            List<RaceTimePoint> raceTimePoints = (await RaceService.GetRaceTimePointsAsync(race.Id)).ToList();
            List<RaceParticipantTimePoint> raceTimePointEvents = await TimingService.GetTimePointsForRaceAsync(race.Id);
            foreach (RaceParticipantTimePoint timePointEvent in raceTimePointEvents)
            {
                timePointEvent.Race = race;
                if (timePointEvent.RaceParticipant is not null)
                    timePointEvent.RaceParticipant.Race = race;
            }
            TimelineTimePoints.AddRange(raceTimePointEvents);

            foreach (RankingEntry rankingEntry in rankings.Where(re =>
                re.RaceParticipant.StartTime.HasValue &&
                !re.RaceParticipant.FinishDateTimeUTC.HasValue &&
                re.SplitTimes.Any(s => s.Value.HasValue) &&
                !re.SplitTimes.All(s => s.Value.HasValue)))
            {
                uint minOpenIndex = rankingEntry.SplitTimes.Where(s => !s.Value.HasValue).Min(s => s.Key);

                FutureRaceParticipantTimePoint ftp = new()
                    {
                        Race = race,
                        RaceParticipant = rankingEntry.RaceParticipant,
                        RaceTimePoint = raceTimePoints.First(rtp => rtp.Index == minOpenIndex)
                    };

                AvailableFTPs.Add(ftp);
            }
        }

        UnassignedTimePoints = await TimingService.GetUnassignedTimePointsAsync();
        TimelineTimePoints.AddRange(UnassignedTimePoints);

        StateHasChanged();
    }

    private void SelectTimePoint(RaceParticipantTimePoint tp)
    {
        if (tp.RaceID.HasValue)
            return;

        SelectedTimePoint = tp.Id == SelectedTimePoint?.Id ? null : tp;
    }

    private void SelectFTP(FutureRaceParticipantTimePoint p)
    {
        SelectedFTP = p;
    }

    private async Task AssignTimePoint()
    {
        if (SelectedTimePoint is null || SelectedFTP is null)
            return;

        await TimingService.AssignTimePointAsync(
            SelectedTimePoint.Id,
            SelectedFTP.Value.Race.Id,
            SelectedFTP.Value.RaceParticipant.ParticipantID);

        await LoadData();
        SelectedTimePoint = null;
        SelectedFTP = null;
    }

    private async Task DeleteTimePoint(Guid id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Wirklich löschen?"))
        {
            await TimingService.DeleteTimePointAsync(id);
            await LoadData();
        }
    }

    private struct FutureRaceParticipantTimePoint
    {
        public required RaceParticipant RaceParticipant { get; init; }
        public required RaceTimePoint RaceTimePoint { get; init; }
        public required Race Race { get; init; }
    }
    }
