@using Microsoft.AspNetCore.Components.Authorization
@using RaceTimerApp.Shared
@using RaceTimerApp.Shared.Pages
@using RaceTimerApp.Shared.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Routes).Assembly" AdditionalAssemblies="[typeof(RaceTimerApp.Shared.Routes).Assembly]" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <p>Für diese Seite ist eine Anmeldung erforderlich.</p>
                    <a href="/account/login">Anmelden</a>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
