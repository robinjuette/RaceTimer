# Host-Port des RaceTimerServer-API-Containers
RACETIMER_SERVER_PORT=8080

# Host-Port des serverseitigen Blazor-Webhosts
RACETIMER_WEB_PORT=8088

# Pflicht-Secrets (vor dem Start setzen, niemals committen)
RACETIMER_DB_PASSWORD=
RACETIMER_BOOTSTRAP_TOKEN=
RACETIMER_WEB_CLIENT_SECRET=

# Öffentlicher HTTPS-Issuer für eine Produktionsbereitstellung
RACETIMER_SERVER_ISSUER=https://localhost:8080/
